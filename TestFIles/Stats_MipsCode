.data
    N:      .word 5
    arr0:   .word 40
    arr1:   .word 10
    arr2:   .word 50
    arr3:   .word 20
    arr4:   .word 30
    median: .word 0
    avg:    .word 0

.text
.globl main
main:
    lw   $s0, 0($0)
    addi $s1, $0, 4

    add  $t0, $0, $0
outer_loop:
    sub  $t1, $s0, $t0
    addi $t1, $t1, -1
    slt  $t2, $0, $t1
    beq  $t2, $0, end_out

    add  $t3, $0, $0
    add  $t4, $s1, $0

inner_loop:
    slt  $t2, $t3, $t1
    beq  $t2, $0, end_in 

    lw   $t5, 0($t4)
    lw   $t6, 4($t4)
    slt  $t7, $t6, $t5
    beq  $t7, $0, no_swp 

    sw   $t6, 0($t4)
    sw   $t5, 4($t4)

no_swp:
    addi $t3, $t3, 1
    addi $t4, $t4, 4
    beq  $0, $0, inner_loop

end_in:
    addi $t0, $t0, 1
    beq  $0, $0, outer_loop

end_out:
    srl  $t0, $s0, 1
    sll  $t0, $t0, 2
    add  $t0, $t0, $s1
    lw   $t1, 0($t0)
    
    sw   $t1, 24($0)      

    add  $t0, $0, $0
    add  $t1, $s1, $0
    add  $t2, $0, $0

sum_loop:
    slt  $t3, $t0, $s0
    beq  $t3, $0, end_sum
    lw   $t4, 0($t1)
    add  $t2, $t2, $t4
    addi $t0, $t0, 1
    addi $t1, $t1, 4
    beq  $0, $0, sum_loop

end_sum:
    add  $t5, $0, $0
div_loop:
    slt  $t3, $t2, $s0
    bne  $t3, $0, end_div
    sub  $t2, $t2, $s0
    addi $t5, $t5, 1
    beq  $0, $0, div_loop

end_div:
    sw   $t5, 28($0)      
    
    addi $v0, $0, 10
    syscall