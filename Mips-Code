.data
    arr:            .word 2, 3, 4, 10, 40       # Sorted array
    size:           .word 5                     # Array ki length
    target:         .word 10                    # Jo dhundhna hai
    
    msg_found:      .asciiz "\nFound at index: "
    msg_not_found:  .asciiz "\nNot found!"

.text
.globl main

main:
    # 1. Sab kuch seedha temporary registers ($t) mein load kar lo
    la $t0, arr          # $t0 = Array ka Base Address
    li $t1, 0            # $t1 = low = 0
    lw $t2, size         
    addi $t2, $t2, -1    # $t2 = high = size - 1 (subi hata diya real mips feel ke liye)
    lw $t3, target       # $t3 = target (10)

search_loop:
    # 2. Condition: Agar low > high ho gaya, toh loop break kar do
    bgt $t1, $t2, print_not_found

    # 3. mid nikalna: mid = (low + high) / 2
    add $t4, $t1, $t2    # $t4 = low + high
    sra $t4, $t4, 1      # $t4 = mid (Divide by 2)

    # 4. arr[mid] ki value memory se lana
    sll $t5, $t4, 2      # $t5 = mid * 4 (4 bytes per word)
    add $t5, $t0, $t5    # $t5 = Base Address + Offset
    lw  $t6, 0($t5)      # $t6 = arr[mid]

    # 5. Check karo match hua kya?
    beq $t6, $t3, print_found

    # 6. Agar arr[mid] < target hai, toh right side jao
    blt $t6, $t3, go_right

go_left:
    # high = mid - 1
    addi $t2, $t4, -1
    j search_loop

go_right:
    # low = mid + 1
    addi $t1, $t4, 1
    j search_loop

# ==========================================
# PRINT & EXIT LOGIC
# ==========================================
print_found:
    li $v0, 4
    la $a0, msg_found
    syscall
    
    li $v0, 1
    move $a0, $t4        # Index ($t4) print karo
    syscall
    j exit

print_not_found:
    li $v0, 4
    la $a0, msg_not_found
    syscall

exit:
    li $v0, 10           # Program khatam
    syscall