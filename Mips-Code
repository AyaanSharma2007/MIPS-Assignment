.data
    # Humara array aur variables yahan define honge
    arr:            .word 2, 3, 4, 10, 40       # Sorted array
    size:           .word 5                     # Array ki length
    target:         .word 10                    # Jo number hum dhundh rahe hain
    
    msg_found:      .asciiz "\nElement found at index: "
    msg_not_found:  .asciiz "\nElement not found in the array!"

.text
.globl main

# ==========================================
# MAIN FUNCTION
# ==========================================
main:
    # Function Arguments load kar rahe hain:
    la $a0, arr          # $a0 = Array ka base address
    li $a1, 0            # $a1 = low = 0
    
    lw $t0, size         # size load kiya
    subi $a2, $t0, 1     # $a2 = high = size - 1
    
    lw $a3, target       # $a3 = target (jisko dhundhna hai)

    # Function call
    jal binary_search
    
    # Result $v0 se $s0 mein save kar liya
    move $s0, $v0

    # Check agar result == -1 (matlab nahi mila)
    li $t0, -1
    beq $s0, $t0, print_not_found

print_found:
    # Success message print karo
    li $v0, 4
    la $a0, msg_found
    syscall
    
    # Index (result) print karo
    li $v0, 1
    move $a0, $s0
    syscall
    j exit

print_not_found:
    # Fail message print karo
    li $v0, 4
    la $a0, msg_not_found
    syscall

exit:
    # Program end karne ka syscall
    li $v0, 10
    syscall

# ==========================================
# BINARY SEARCH PROCEDURE
# Arguments: $a0 = arr base, $a1 = low, $a2 = high, $a3 = target
# Returns:   $v0 = index (if found), ya fir -1 (if not found)
# ==========================================
binary_search:
loop:
    # condition: while (low <= high) -> agar low > high toh loop break
    bgt $a1, $a2, not_in_array

    # mid = (low + high) / 2
    add $t0, $a1, $a2    # $t0 = low + high
    sra $t0, $t0, 1      # $t0 = $t0 / 2 (Shift Right Arithmetic se divide by 2)

    # arr[mid] ki value memory se nikalna (Pointer arithmetic)
    sll $t1, $t0, 2      # $t1 = mid * 4 (kyunki MIPS mein 1 word = 4 bytes)
    add $t1, $a0, $t1    # $t1 = base_address + (mid * 4) -> address of arr[mid]
    lw $t2, 0($t1)       # $t2 = arr[mid] (value load ho gayi)

    # Check 1: if (arr[mid] == target)
    beq $t2, $a3, found_it

    # Check 2: if (arr[mid] < target)
    blt $t2, $a3, go_right

go_left:
    # else ki condition: high = mid - 1
    subi $a2, $t0, 1
    j loop

go_right:
    # low = mid + 1
    addi $a1, $t0, 1
    j loop

found_it:
    move $v0, $t0        # index ($t0) ko return register ($v0) mein daalo
    jr $ra               # Return to caller (main)

not_in_array:
    li $v0, -1           # -1 daalo return register mein
    jr $ra               # Return to caller